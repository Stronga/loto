.intro-root {
    width: 620px;
    height: auto;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
}

.intro-panel {
    padding: 28px;
    border-radius: 32px;
    background-color: rgba(8, 14, 22, 0.82);
    border-width: 1.5px;
    border-color: rgba(120, 210, 255, 0.55);
}

.intro-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 22px;
    align-self: center;
}

.intro-status-dot {
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    border-radius: 10px;
    background-color: rgb(80, 190, 255);
    margin-right: 16px;
}

.intro-title-group {
    flex-direction: column;
    -unity-text-align: upper-center;
    align-items: center;
    align-self: center;
}

.intro-title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(245, 250, 255);
    -unity-text-align: upper-center;
}

.intro-subtitle {
    font-size: 19px;
    color: rgba(210, 230, 245, 0.78);
    margin-top: 4px;
    -unity-text-align: upper-center;
}

.intro-description {
    font-size: 22px;
    line-height: 30px;
    white-space: normal;
    color: rgb(232, 242, 250);
    margin-bottom: 22px;
}

.intro-info-card {
    padding: 18px 20px;
    border-radius: 22px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    margin-bottom: 18px;
}

.intro-section-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(120, 220, 255);
    margin-bottom: 10px;
}

.intro-step {
    font-size: 21px;
    color: rgb(240, 246, 252);
    margin-bottom: 7px;
}

.intro-warning-card {
    min-height: 86px;
    padding: 16px 18px;
    border-radius: 22px;
    flex-direction: row;
    align-items: flex-start;
    background-color: rgba(255, 180, 60, 0.18);
    border-width: 1px;
    border-color: rgba(255, 190, 80, 0.72);
    margin-bottom: 22px;
}

.intro-warning-icon {
    width: 34px;
    height: 34px;
    min-width: 34px;
    min-height: 34px;
    border-radius: 17px;
    -unity-text-align: middle-center;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(40, 28, 8);
    background-color: rgb(255, 190, 80);
    margin-right: 14px;
}

.intro-warning-text {
    flex-grow: 1;
    font-size: 20px;
    line-height: 27px;
    white-space: normal;
    color: rgb(255, 244, 225);
}

.intro-footer {
    flex-direction: column;
    align-items: stretch;
}

.intro-interaction-hint {
    font-size: 18px;
    color: rgba(210, 230, 245, 0.72);
    white-space: normal;
    margin-bottom: 16px;
}

.start-process-button {
    height: 56px;
    border-radius: 28px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(5, 12, 18);
    background-color: rgb(120, 220, 255);
}
