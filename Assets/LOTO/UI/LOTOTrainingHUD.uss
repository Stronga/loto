.hud-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    padding-left: 28px;
    padding-top: 28px;
    picking-mode: ignore;
}

.checklist-panel {
    width: 320px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(12, 16, 20, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(255, 255, 255, 0.18);
    border-top-color: rgba(255, 255, 255, 0.18);
    border-bottom-color: rgba(255, 255, 255, 0.18);
    picking-mode: ignore;
}

.title {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.step {
    color: rgb(228, 235, 241);
    font-size: 15px;
    margin-top: 4px;
    margin-bottom: 4px;
    white-space: nowrap;
}

.step-complete {
    color: rgb(108, 230, 151);
}

.warning-panel {
    display: none;
    width: 440px;
    margin-top: 14px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(168, 18, 16, 0.92);
    picking-mode: ignore;
}

.warning-message {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}
